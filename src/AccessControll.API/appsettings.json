{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARS_LONG_FOR_PROD",
    "Issuer": "AccessControll.API",
    "Audience": "AccessControll.Clients",
    "ExpireMinutes": "60"
  },
  "Cors": {
    "BlazorOrigin": "https://localhost:"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
      //"Override": {
      //  "Microsoft": "Warning",
      //  "System": "Warning"
      //}
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
      //"Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
