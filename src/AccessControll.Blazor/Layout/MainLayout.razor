@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AccessControll.Blazor.Services.IAuthService AuthService
@inject AccessControll.Blazor.Services.IPanelService PanelService

<div class="layout-container" dir="rtl">

    <!-- Mobile top bar -->
    <div class="topbar">
        <button class="hamburger" @onclick="ToggleSidebar">☰</button>
        <span class="topbar-logo">🔐 AccessControll</span>
    </div>

    <!-- Overlay for mobile -->
    @if (_sidebarOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
    }

    <nav class="sidebar @(_sidebarOpen ? "sidebar-open" : "")">
        <div class="sidebar-header">
            <span class="logo">🔐 AccessControll</span>
            <span class="subtitle">کنترل دسترسی</span>
        </div>
        <AuthorizeView>
            <Authorized Context="outerAuth">
                <ul class="nav-list">
                    <li><a href="/" class="nav-link" @onclick="CloseSidebar">🏠 داشبورد</a></li>
                    @if (_panels.Contains("doors"))
                    {
                        <li><a href="/doors" class="nav-link" @onclick="CloseSidebar">⚡ مدیریت خروجی‌ها</a></li>
                    }
                    @if (_panels.Contains("logs"))
                    {
                        <li><a href="/logs" class="nav-link" @onclick="CloseSidebar">📋 لاگ دسترسی</a></li>
                    }
                    @if (_panels.Contains("stations"))
                    {
                        <li><a href="/stations" class="nav-link" @onclick="CloseSidebar">🖥️ ایستگاه‌ها</a></li>
                    }
                    @if (_panels.Contains("users"))
                    {
                        <li><a href="/users" class="nav-link" @onclick="CloseSidebar">👥 کاربران</a></li>
                    }
                    @if (_panels.Contains("roles"))
                    {
                        <li><a href="/roles" class="nav-link" @onclick="CloseSidebar">🎭 نقش‌ها</a></li>
                    }
                    <li><a href="/profile" class="nav-link" @onclick="CloseSidebar">⚙️ پروفایل</a></li>
                    <li>
                        <button class="nav-link btn-logout" @onclick="HandleLogout">🚪 خروج</button>
                    </li>
                </ul>
                <div class="user-info">
                    <span>@outerAuth.User.Identity?.Name</span>
                </div>
            </Authorized>
            <NotAuthorized>
                <ul class="nav-list">
                    <li><a href="/login" class="nav-link">🔑 ورود</a></li>
                </ul>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <main class="main-content">
        <div class="content-wrapper">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _sidebarOpen = false;
    private List<string> _panels = new();

    protected override async Task OnInitializedAsync()
    {
        _panels = await PanelService.GetMyPanelsAsync();
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }
}

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f0f2f5; }

    .layout-container { display: flex; min-height: 100vh; direction: rtl; }

    /* ── Top bar (mobile only) ── */
    .topbar {
        display: none;
        position: fixed; top: 0; right: 0; left: 0; z-index: 200;
        height: 56px; background: #1a1a2e;
        align-items: center; padding: 0 16px; gap: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .hamburger {
        background: none; border: none; color: white;
        font-size: 22px; cursor: pointer; padding: 4px 8px;
        border-radius: 6px; line-height: 1;
    }
    .hamburger:hover { background: rgba(255,255,255,0.1); }
    .topbar-logo { color: white; font-size: 16px; font-weight: 700; }

    /* ── Sidebar overlay (mobile) ── */
    .sidebar-overlay {
        display: none;
        position: fixed; inset: 0; z-index: 150;
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(2px);
    }

    /* ── Sidebar ── */
    .sidebar {
        width: 240px; min-height: 100vh;
        background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        color: white; padding: 0; display: flex; flex-direction: column;
        box-shadow: 2px 0 10px rgba(0,0,0,0.3);
        position: fixed; right: 0; top: 0; z-index: 160;
        transition: transform 0.3s ease;
    }

    .sidebar-header {
        padding: 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.1);
        display: flex; flex-direction: column; gap: 4px;
    }
    .logo { font-size: 20px; font-weight: 700; letter-spacing: 1px; }
    .subtitle { font-size: 11px; color: rgba(255,255,255,0.5); }

    .nav-list { list-style: none; padding: 12px 0; flex: 1; }
    .nav-list li { margin: 2px 12px; }

    .nav-link {
        display: block; padding: 10px 14px; border-radius: 8px; color: rgba(255,255,255,0.75);
        text-decoration: none; font-size: 14px; transition: all 0.2s; cursor: pointer;
        background: none; border: none; width: 100%; text-align: right;
    }
    .nav-link:hover { background: rgba(255,255,255,0.12); color: white; transform: translateX(-3px); }

    .btn-logout { color: #ff6b6b; }
    .btn-logout:hover { background: rgba(255,107,107,0.15) !important; color: #ff6b6b !important; }

    .user-info { padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 12px; color: rgba(255,255,255,0.5); }

    /* ── Main content ── */
    .main-content { margin-right: 240px; flex: 1; min-height: 100vh; overflow-x: hidden; }
    .content-wrapper { padding: 28px; max-width: 1200px; }

    .access-denied, .not-found { padding: 60px; text-align: center; color: #666; }
    .access-denied h2, .not-found h2 { font-size: 28px; margin-bottom: 12px; }

    /* ── Mobile ── */
    @@media (max-width: 768px) {
        .topbar { display: flex; }
        .sidebar-overlay { display: block; }

        .sidebar {
            transform: translateX(100%);
        }
        .sidebar.sidebar-open {
            transform: translateX(0);
        }

        .main-content {
            margin-right: 0;
            padding-top: 56px;
        }
        .content-wrapper {
            padding: 16px;
        }
    }
</style>
