@page "/login"
@using AccessControll.Blazor.Services
@inject IAuthService AuthService
@inject NavigationManager Nav
@layout AccessControll.Blazor.Layout.EmptyLayout

<div class="login-page" dir="rtl">
    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">🔐</div>
            <h1>AccessControll</h1>
            <p>سیستم کنترل دسترسی</p>
        </div>

        <!-- Mode Tabs -->
        @if (!_requiresTwoFactor)
        {
            <div class="tabs">
                <button class="tab @(_mode == LoginMode.Password ? "tab-active" : "")"
                        @onclick="@(() => SwitchMode(LoginMode.Password))">
                    رمز عبور
                </button>
                <button class="tab @(_mode == LoginMode.Totp ? "tab-active" : "")"
                        @onclick="@(() => SwitchMode(LoginMode.Totp))">
                    کد ۲FA
                </button>
            </div>
        }

        @if (_mode == LoginMode.Password && !_requiresTwoFactor)
        {
            <!-- Email + Password mode -->
            <div class="form-group">
                <label>ایمیل</label>
                <input type="email" @bind="_email" placeholder="email@example.com" class="form-input" />
            </div>
            <div class="form-group">
                <label>رمز عبور</label>
                <input type="password" @bind="_password" placeholder="••••••••" class="form-input"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await HandlePasswordLogin(); })" />
            </div>
        }
        else if (_mode == LoginMode.Totp && !_requiresTwoFactor)
        {
            <!-- 2FA-only mode (no email needed) -->
            <div class="twofa-notice">
                <div class="twofa-icon">📱</div>
                <p>کد ۶ رقمی اپ احراز هویت خود را وارد کنید</p>
                <p class="twofa-hint">این روش بدون نیاز به ایمیل کار می‌کند</p>
            </div>
            <div class="form-group">
                <label>کد ۶ رقمی</label>
                <input type="text" @bind="_totpCode" placeholder="123456" class="form-input code-input"
                       maxlength="6" @onkeydown="@(async e => { if (e.Key == "Enter") await HandleTotpLogin(); })" />
            </div>
        }
        else if (_requiresTwoFactor)
        {
            <!-- 2FA step after password login -->
            <div class="twofa-notice">
                <div class="twofa-icon">📱</div>
                <p>احراز هویت دو مرحله‌ای فعال است</p>
                <p class="twofa-hint">کد تأیید از اپ احراز هویت خود را وارد کنید</p>
            </div>
            <div class="form-group">
                <label>کد ۶ رقمی</label>
                <input type="text" @bind="_twoFactorCode" placeholder="123456" class="form-input code-input"
                       maxlength="6" @onkeydown="@(async e => { if (e.Key == "Enter") await HandleTwoFactorStep(); })" />
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-alert">⚠️ @_error</div>
        }

        @if (_mode == LoginMode.Password && !_requiresTwoFactor)
        {
            <button class="btn-login" @onclick="HandlePasswordLogin" disabled="@_loading">
                @if (_loading) { <span class="spinner"></span> <span>در حال ورود...</span> }
                else { <span>ورود به سیستم</span> }
            </button>
        }
        else if (_mode == LoginMode.Totp && !_requiresTwoFactor)
        {
            <button class="btn-login" @onclick="HandleTotpLogin" disabled="@_loading">
                @if (_loading) { <span class="spinner"></span> <span>در حال تأیید...</span> }
                else { <span>ورود با کد 2FA</span> }
            </button>
        }
        else if (_requiresTwoFactor)
        {
            <button class="btn-login" @onclick="HandleTwoFactorStep" disabled="@_loading">
                @if (_loading) { <span class="spinner"></span> <span>در حال تأیید...</span> }
                else { <span>تأیید کد</span> }
            </button>
            <button class="btn-back" @onclick="@(() => { _requiresTwoFactor = false; _twoFactorCode = ""; _error = ""; })">
                ← بازگشت
            </button>
        }
    </div>
</div>

@code {
    private enum LoginMode { Password, Totp }

    private LoginMode _mode = LoginMode.Password;
    private string _email = "";
    private string _password = "";
    private string _twoFactorCode = "";
    private string _totpCode = "";
    private bool _requiresTwoFactor = false;
    private bool _loading = false;
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsSetupRequiredAsync())
            Nav.NavigateTo("/setup");
    }

    private void SwitchMode(LoginMode mode)
    {
        _mode = mode;
        _error = "";
        _requiresTwoFactor = false;
    }

    private async Task HandlePasswordLogin()
    {
        if (_loading) return;
        _loading = true;
        _error = "";

        var result = await AuthService.LoginAsync(_email, _password);

        if (result.Succeeded)
            Nav.NavigateTo("/");
        else if (result.RequiresTwoFactor)
            _requiresTwoFactor = true;
        else
            _error = result.Error ?? "خطا در ورود";

        _loading = false;
    }

    private async Task HandleTwoFactorStep()
    {
        if (_loading) return;
        _loading = true;
        _error = "";

        var result = await AuthService.Login2FAAsync(_twoFactorCode);

        if (result.Succeeded)
            Nav.NavigateTo("/");
        else
            _error = result.Error ?? "کد نامعتبر است";

        _loading = false;
    }

    private async Task HandleTotpLogin()
    {
        if (_loading) return;
        _loading = true;
        _error = "";

        var result = await AuthService.Login2FAAsync(_totpCode);

        if (result.Succeeded)
            Nav.NavigateTo("/");
        else
            _error = result.Error ?? "کد نامعتبر یا منقضی شده است";

        _loading = false;
    }
}

<style>
    .login-page {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #0a192f 0%, #112240 50%, #0f3460 100%);
        padding: 20px;
    }
    .login-card {
        background: white; border-radius: 16px; padding: 40px;
        width: 100%; max-width: 420px; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        direction: rtl;
    }
    .login-header { text-align: center; margin-bottom: 28px; }
    .login-icon { font-size: 48px; margin-bottom: 12px; }
    .login-header h1 { font-size: 26px; font-weight: 700; color: #0a192f; margin-bottom: 6px; }
    .login-header p { color: #64748b; font-size: 14px; }

    .tabs { display: flex; gap: 0; margin-bottom: 28px; border: 2px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
    .tab {
        flex: 1; padding: 10px; background: white; border: none; font-size: 14px; font-weight: 500;
        color: #64748b; cursor: pointer; transition: all 0.2s;
    }
    .tab-active { background: #0a192f; color: white; }
    .tab:first-child { border-left: 1px solid #e2e8f0; }

    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .form-input {
        width: 100%; padding: 11px 14px; border: 2px solid #e2e8f0; border-radius: 8px;
        font-size: 15px; transition: border-color 0.2s; outline: none; direction: ltr;
        box-sizing: border-box;
    }
    .form-input:focus { border-color: #64ffda; box-shadow: 0 0 0 3px rgba(100,255,218,0.15); }
    .code-input { text-align: center; font-size: 24px; letter-spacing: 8px; }

    .twofa-notice {
        background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px;
        padding: 16px; text-align: center; margin-bottom: 20px;
    }
    .twofa-icon { font-size: 32px; margin-bottom: 8px; }
    .twofa-notice p { font-size: 13px; color: #166534; line-height: 1.6; }
    .twofa-hint { color: #4ade80 !important; font-size: 12px !important; margin-top: 4px; }

    .error-alert {
        background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; border-radius: 8px;
        padding: 12px; font-size: 13px; margin-bottom: 16px;
    }

    .btn-login {
        width: 100%; padding: 14px; background: linear-gradient(135deg, #0a192f, #0f3460);
        color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 600;
        cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;
        margin-bottom: 10px;
    }
    .btn-login:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(10,25,47,0.4); }
    .btn-login:disabled { opacity: 0.7; cursor: not-allowed; }

    .btn-back {
        width: 100%; padding: 10px; background: none; border: 1px solid #e2e8f0; border-radius: 8px;
        color: #64748b; font-size: 14px; cursor: pointer; transition: all 0.2s;
    }
    .btn-back:hover { background: #f8fafc; }

    .spinner {
        width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white; border-radius: 50%; animation: spin 0.8s linear infinite;
        display: inline-block;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
