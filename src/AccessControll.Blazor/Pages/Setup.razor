@page "/setup"
@using AccessControll.Blazor.Services
@inject IAuthService AuthService
@inject NavigationManager Nav
@layout AccessControll.Blazor.Layout.EmptyLayout

<div class="setup-page" dir="rtl">
    <div class="setup-card">
        <div class="setup-header">
            <div class="setup-icon">⚙️</div>
            <h1>راه‌اندازی اولیه</h1>
            <p>اولین حساب کاربری سیستم را بسازید</p>
        </div>

        @if (!_done)
        {
            <div class="info-banner">
                این صفحه فقط یک بار قابل استفاده است.<br />
                کاربری که اینجا ثبت می‌شود، مدیر اصلی سیستم خواهد بود.
            </div>

            <div class="form-group">
                <label>نام کامل</label>
                <input type="text" @bind="_fullName" placeholder="نام و نام خانوادگی" class="form-input" />
            </div>
            <div class="form-group">
                <label>ایمیل</label>
                <input type="email" @bind="_email" placeholder="admin@example.com" class="form-input" />
            </div>
            <div class="form-group">
                <label>رمز عبور</label>
                <input type="password" @bind="_password" placeholder="حداقل ۸ کاراکتر" class="form-input" />
            </div>
            <div class="form-group">
                <label>تکرار رمز عبور</label>
                <input type="password" @bind="_confirmPassword" placeholder="رمز عبور را دوباره وارد کنید" class="form-input"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await HandleSetup(); })" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="error-alert">⚠️ @_error</div>
            }

            <button class="btn-setup" @onclick="HandleSetup" disabled="@_loading">
                @if (_loading) { <span class="spinner"></span> <span>در حال ثبت‌نام...</span> }
                else { <span>ساخت حساب مدیر</span> }
            </button>
        }
        else
        {
            <div class="success-banner">
                ✅ حساب مدیر با موفقیت ساخته شد.<br />
                در حال انتقال به سیستم...
            </div>
        }
    </div>
</div>

@code {
    private string _fullName = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";
    private bool _loading = false;
    private bool _done = false;
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        // اگر سیستم از قبل راه‌اندازی شده، برگرد به لاگین
        if (!await AuthService.IsSetupRequiredAsync())
            Nav.NavigateTo("/login");
    }

    private async Task HandleSetup()
    {
        if (_loading) return;
        _error = "";

        if (string.IsNullOrWhiteSpace(_fullName) || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "لطفاً همه فیلدها را پر کنید";
            return;
        }

        if (_password != _confirmPassword)
        {
            _error = "رمز عبور و تکرار آن یکسان نیستند";
            return;
        }

        _loading = true;
        var result = await AuthService.SetupAsync(_fullName, _email, _password);
        _loading = false;

        if (result.Succeeded)
        {
            _done = true;
            await Task.Delay(1200);
            Nav.NavigateTo("/");
        }
        else
        {
            _error = result.Error ?? "خطا در ثبت‌نام";
        }
    }
}

<style>
    .setup-page {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #0a192f 0%, #112240 50%, #0f3460 100%);
        padding: 20px;
    }
    .setup-card {
        background: white; border-radius: 16px; padding: 40px;
        width: 100%; max-width: 440px; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        direction: rtl;
    }
    .setup-header { text-align: center; margin-bottom: 24px; }
    .setup-icon { font-size: 48px; margin-bottom: 12px; }
    .setup-header h1 { font-size: 24px; font-weight: 700; color: #0a192f; margin-bottom: 6px; }
    .setup-header p { color: #64748b; font-size: 14px; }

    .info-banner {
        background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px;
        padding: 14px; font-size: 13px; color: #1e40af; line-height: 1.7;
        text-align: center; margin-bottom: 22px;
    }
    .success-banner {
        background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px;
        padding: 20px; font-size: 14px; color: #166534; line-height: 1.8;
        text-align: center;
    }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .form-input {
        width: 100%; padding: 11px 14px; border: 2px solid #e2e8f0; border-radius: 8px;
        font-size: 15px; transition: border-color 0.2s; outline: none; direction: ltr;
        box-sizing: border-box;
    }
    .form-input:focus { border-color: #64ffda; box-shadow: 0 0 0 3px rgba(100,255,218,0.15); }

    .error-alert {
        background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; border-radius: 8px;
        padding: 12px; font-size: 13px; margin-bottom: 16px;
    }

    .btn-setup {
        width: 100%; padding: 14px; background: linear-gradient(135deg, #0a192f, #0f3460);
        color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 600;
        cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-setup:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(10,25,47,0.4); }
    .btn-setup:disabled { opacity: 0.7; cursor: not-allowed; }

    .spinner {
        width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white; border-radius: 50%; animation: spin 0.8s linear infinite;
        display: inline-block;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
