@page "/stations"
@using AccessControll.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@implements IAsyncDisposable
@inject IStationService StationService
@inject DoorHubService HubService
@inject NavigationManager Nav

<PageTitle>مدیریت ایستگاه‌ها — AccessControll</PageTitle>

<div class="page" dir="rtl">
    <div class="page-header">
        <h1>🖥️ مدیریت ایستگاه‌ها</h1>
        <div style="display:flex;gap:10px;">
            <button class="btn-secondary" @onclick="OpenProvModal" disabled="@_provisioning">
                @(_provisioning ? "⏳ در حال پروویژن..." : "🔌 پروویژن دستگاه جدید (UART)")
            </button>
            <button class="btn-primary" @onclick="ScanNetwork" disabled="@_scanning">
                @(_scanning ? "⏳ در حال اسکن شبکه..." : "🔍 جستجوی دستگاه‌ها در شبکه")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_msgSuccess ? "alert-success" : "alert-error")">@_message</div>
    }

    <!-- ── Discovered but unregistered ────────────────────────────────────── -->
    @if (_discovered.Count > 0)
    {
        <div class="section">
            <h2 class="section-title">📡 دستگاه‌های یافت شده (ثبت نشده)</h2>
            <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>آدرس IP</th>
                        <th>مک آدرس</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _discovered)
                    {
                        <tr>
                            <td dir="ltr">@s.Ip</td>
                            <td dir="ltr">@s.Mac</td>
                            <td>
                                <button class="btn-sm btn-primary" @onclick="@(() => OpenRegisterModal(s.Mac, s.Ip))">
                                    + ثبت دستگاه
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }

    <!-- ── Registered stations ────────────────────────────────────────────── -->
    <div class="section">
        <h2 class="section-title">✅ دستگاه‌های ثبت شده</h2>

        @if (_stations.Count == 0)
        {
            <div class="empty-state">هیچ دستگاهی ثبت نشده است. ابتدا جستجو را انجام دهید.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>نام</th>
                        <th>مک آدرس</th>
                        <th>آخرین IP</th>
                        <th>نوع</th>
                        <th>توضیحات</th>
                        <th>اتصال</th>
                        <th>وضعیت</th>
                        <th>آخرین اتصال</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _stations)
                    {
                        <tr class="@(!s.IsEnabled ? "row-disabled" : "")">
                            <td><strong>@s.Name</strong></td>
                            <td dir="ltr">@s.MacAddress</td>
                            <td dir="ltr">@(s.LastKnownIp ?? "—")</td>
                            <td>
                                <span class="badge @TypeBadgeClass(s.Type)">@TypeLabel(s.Type)</span>
                            </td>
                            <td>@(s.Description ?? "—")</td>
                            <td>
                                <span class="badge @(s.IsConnected ? "badge-green" : "badge-gray")">
                                    @(s.IsConnected ? "متصل" : "قطع")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(s.IsEnabled ? "badge-blue" : "badge-gray")">
                                    @(s.IsEnabled ? "فعال" : "غیرفعال")
                                </span>
                            </td>
                            <td>@(s.LastSeen.HasValue ? s.LastSeen.Value.ToLocalTime().ToString("yy/MM/dd HH:mm") : "—")</td>
                            <td class="actions">
                                @if (!s.IsConnected && !string.IsNullOrEmpty(s.LastKnownIp))
                                {
                                    <button class="btn-icon" @onclick="@(() => ConnectStation(s.MacAddress))" title="اتصال مجدد">🔗</button>
                                }
                                <button class="btn-icon" @onclick="@(() => OpenEditModal(s))" title="ویرایش">✏️</button>
                                <button class="btn-icon btn-del" @onclick="@(() => DeleteStation(s.MacAddress))" title="حذف">🗑️</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>

<!-- Provision Modal -->
@if (_showProvModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal modal-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>🔌 پروویژن دستگاه جدید</h3>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body modal-body-scroll">

                <div class="form-row">
                    <label>آدرس سرور <span class="label-hint">(host:port که ESP وصل میشه)</span></label>
                    <input type="text" @bind="_provForm.ServerAddress" class="form-input" dir="ltr" placeholder="مثلاً 192.168.1.100:80" />
                </div>

                <div class="form-row">
                    <label>پورت سریال</label>
                    <input type="text" @bind="_provForm.PortName" class="form-input" dir="ltr"
                           list="port-suggestions" placeholder="مثلاً COM3 یا /dev/ttyUSB0" />
                    <datalist id="port-suggestions">
                        @foreach (var port in _provPorts)
                        {
                            <option value="@port" />
                        }
                    </datalist>
                    @if (_provPorts.Length == 0)
                    {
                        <div class="prov-warn">پورتی شناسایی نشد — دستی وارد کنید.</div>
                    }
                </div>

                <div class="form-grid-2">
                    <div class="form-row">
                        <label>WiFi SSID</label>
                        <input type="text" @bind="_provForm.Ssid" class="form-input" dir="ltr" placeholder="نام شبکه" />
                    </div>
                    <div class="form-row">
                        <label>WiFi Password</label>
                        <div style="display:flex;gap:6px;align-items:center;">
                            <input type="@(_showProvPass ? "text" : "password")" @bind="_provForm.Password" class="form-input" dir="ltr" placeholder="رمز WiFi" style="flex:1;" />
                            <button class="btn-toggle-pass" @onclick="@(() => _showProvPass = !_showProvPass)">@(_showProvPass ? "🙈" : "👁️")</button>
                        </div>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-row">
                        <label>نام دستگاه</label>
                        <input type="text" @bind="_provForm.Name" class="form-input" placeholder="مثلاً: ورودی اصلی" />
                    </div>
                    <div class="form-row">
                        <label>نوع <span class="label-hint">(در firmware بیک می‌شود)</span></label>
                        <select @bind="_provForm.StationType" class="form-input">
                            <option value="0">🖥️ جنرال</option>
                            <option value="1">🚪 در</option>
                            <option value="2">📡 ریموت کنترل</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <label>توضیحات (اختیاری)</label>
                    <input type="text" @bind="_provForm.Description" class="form-input" placeholder="توضیحات" />
                </div>

                <div class="form-row form-row-check">
                    <label class="check-label">
                        <input type="checkbox" @bind="_provForm.FlashFirst" />
                        <span>فلش firmware قبل از پروویژن (نیاز به arduino-cli)</span>
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(_provResult))
                {
                    <div class="alert @(_provSuccess ? "alert-success" : "alert-error")">@_provResult</div>
                }

                @if (_liveFlashLines.Count > 0 || !string.IsNullOrEmpty(_flashOutput))
                {
                    <details class="flash-log" open="@(_provisioning)">
                        <summary>خروجی arduino-cli @(_provisioning ? "(در حال دریافت...)" : "")</summary>
                        <pre id="flash-pre">@(string.Join("\n", _liveFlashLines))</pre>
                    </details>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseModals">انصراف</button>
                <button class="btn-primary" @onclick="SaveProvision" disabled="@(_provisioning || string.IsNullOrEmpty(_provForm.PortName))">
                    @if (_provisioning)
                    {
                        @(_provForm.FlashFirst ? "⏳ در حال فلش و پروویژن..." : "⏳ در حال پروویژن...")
                    }
                    else
                    {
                        @(_provForm.FlashFirst ? "فلش + پروویژن + ریبوت" : "پروویژن و ریبوت")
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Register Modal -->
@if (_showRegModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>ثبت دستگاه جدید</h3>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <label>مک آدرس</label>
                    <input type="text" value="@_regForm.MacAddress" class="form-input" dir="ltr" readonly />
                </div>
                <div class="form-row">
                    <label>آدرس IP</label>
                    <input type="text" value="@_regForm.Ip" class="form-input" dir="ltr" readonly />
                </div>
                <div class="form-row">
                    <label>نام دستگاه</label>
                    <input type="text" @bind="_regForm.Name" class="form-input" placeholder="مثلاً: ایستگاه ورودی اصلی" />
                </div>
                <div class="form-row">
                    <label>نوع استیشن</label>
                    <select @bind="_regForm.Type" class="form-input">
                        <option value="0">🖥️ جنرال — کیبورد و نمایشگر (کد خروجی جهانی)</option>
                        <option value="1">🚪 در — کیبورد و نمایشگر (باز کردن خودکار)</option>
                        <option value="2">📡 ریموت کنترل — بدون LCD/کیبورد</option>
                    </select>
                </div>
                <div class="form-row">
                    <label>توضیحات (اختیاری)</label>
                    <input type="text" @bind="_regForm.Description" class="form-input" placeholder="توضیحات" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseModals">انصراف</button>
                <button class="btn-primary" @onclick="SaveRegister" disabled="@_saving">
                    @(_saving ? "ذخیره..." : "ثبت دستگاه")
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Modal -->
@if (_showEditModal && _editTarget != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>ویرایش دستگاه</h3>
                <button class="modal-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <label>مک آدرس</label>
                    <input type="text" value="@_editTarget.MacAddress" class="form-input" dir="ltr" readonly />
                </div>
                <div class="form-row">
                    <label>نام دستگاه</label>
                    <input type="text" @bind="_editForm.Name" class="form-input" />
                </div>
                <div class="form-row">
                    <label>توضیحات (اختیاری)</label>
                    <input type="text" @bind="_editForm.Description" class="form-input" />
                </div>
                <div class="form-row">
                    <label>نوع استیشن</label>
                    <select @bind="_editForm.Type" class="form-input">
                        <option value="0">🖥️ جنرال — کیبورد و نمایشگر (کد خروجی جهانی)</option>
                        <option value="1">🚪 در — کیبورد و نمایشگر (باز کردن خودکار)</option>
                        <option value="2">📡 ریموت کنترل — بدون LCD/کیبورد</option>
                    </select>
                </div>
                <div class="form-row">
                    <label>وضعیت</label>
                    <label class="toggle">
                        <input type="checkbox" @bind="_editForm.IsEnabled" />
                        <span class="toggle-slider"></span>
                        <span>@(_editForm.IsEnabled ? "فعال" : "غیرفعال")</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseModals">انصراف</button>
                <button class="btn-primary" @onclick="SaveEdit" disabled="@_saving">
                    @(_saving ? "ذخیره..." : "ذخیره")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<StationDto> _stations = new();
    private List<DiscoveredStationDto> _discovered = new();
    private bool _scanning;
    private bool _saving;
    private string _message = "";
    private bool _msgSuccess;

    // Provision modal
    private bool _showProvModal;
    private bool _provisioning;
    private bool _showProvPass;
    private string[] _provPorts = Array.Empty<string>();
    private ProvForm _provForm = new();
    private string _provResult = "";
    private bool _provSuccess;
    private string? _flashOutput;
    private List<string> _liveFlashLines = new();
    private string? _provSessionId;

    // Register modal
    private bool _showRegModal;
    private RegForm _regForm = new();

    // Edit modal
    private bool _showEditModal;
    private StationDto? _editTarget;
    private EditForm _editForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStations();

        await HubService.StartAsync();
        HubService.OnStationStatusChanged += OnStationStatusChanged;
    }

    private void OnStationStatusChanged(string mac, bool isConnected)
    {
        var idx = _stations.FindIndex(s =>
            s.MacAddress.Equals(mac, StringComparison.OrdinalIgnoreCase));
        if (idx >= 0)
        {
            _stations[idx] = _stations[idx] with { IsConnected = isConnected };
            InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        HubService.OnStationStatusChanged -= OnStationStatusChanged;
        await Task.CompletedTask;
    }

    private async Task LoadStations()
    {
        _stations = await StationService.GetAllAsync();
    }

    private async Task ScanNetwork()
    {
        _scanning = true;
        _discovered = new();
        StateHasChanged();

        var all = await StationService.ScanNetworkAsync();
        _discovered = all.Where(d => !d.IsRegistered).ToList();

        await LoadStations();

        _scanning = false;
        _message = $"اسکن انجام شد: {all.Count} دستگاه یافت شد، {_discovered.Count} دستگاه ثبت نشده";
        _msgSuccess = true;
        StateHasChanged();

        await Task.Delay(5000);
        _message = "";
        StateHasChanged();
    }

    private async Task ConnectStation(string mac)
    {
        var ok = await StationService.ConnectAsync(mac);
        _message = ok ? "در انتظار اتصال خودکار دستگاه..." : "خطا در ارتباط با سرور";
        _msgSuccess = ok;
        StateHasChanged();
        await Task.Delay(3000);
        _message = "";
        StateHasChanged();
    }

    private async Task OpenProvModal()
    {
        var uri = new Uri(Nav.BaseUri);
        var defaultPort = uri.Port is 80 or 443 or -1 ? (uri.Port == -1 ? 80 : uri.Port) : uri.Port;
        _provForm = new ProvForm { ServerAddress = $"{uri.Host}:{defaultPort}" };
        _provResult = "";
        _flashOutput = null;
        _liveFlashLines = new();
        _provSessionId = null;
        _showProvModal = true;

        await HubService.StartAsync();

        _provPorts = await StationService.GetSerialPortsAsync();
        if (_provPorts.Length == 1)
            _provForm.PortName = _provPorts[0];
        StateHasChanged();
    }

    private async Task SaveProvision()
    {
        if (string.IsNullOrWhiteSpace(_provForm.Ssid))
        {
            _provResult = "SSID را وارد کنید";
            _provSuccess = false;
            return;
        }
        if (string.IsNullOrWhiteSpace(_provForm.Name))
        {
            _provResult = "نام دستگاه را وارد کنید";
            _provSuccess = false;
            return;
        }

        _provisioning = true;
        _provResult = "";
        _flashOutput = null;
        _liveFlashLines = new();
        StateHasChanged();

        // Subscribe to live flash log lines before starting
        _provSessionId = Guid.NewGuid().ToString("N");
        HubService.OnFlashLog += AppendFlashLine;
        await HubService.JoinProvisionSessionAsync(_provSessionId);

        // parse ServerAddress → host + port
        string? sHost = null; int? sPort = null;
        if (!string.IsNullOrWhiteSpace(_provForm.ServerAddress))
        {
            var parts = _provForm.ServerAddress.Split(':');
            sHost = parts[0].Trim();
            if (parts.Length > 1 && int.TryParse(parts[1].Trim(), out var sp)) sPort = sp;
        }

        var (ok, mac, alreadyReg, err, flashOut) = await StationService.ProvisionAsync(
            _provForm.PortName, _provForm.Ssid, _provForm.Password,
            _provForm.Name, _provForm.Description, _provForm.FlashFirst, _provSessionId, _provForm.StationType, sHost, sPort);

        // Cleanup SignalR subscription
        HubService.OnFlashLog -= AppendFlashLine;
        await HubService.LeaveProvisionSessionAsync(_provSessionId);
        _provSessionId = null;

        _provisioning = false;
        _flashOutput = flashOut;

        if (ok)
        {
            _provResult = alreadyReg
                ? $"پروویژن موفق — MAC: {mac} — دستگاه قبلاً ثبت شده بود، در حال ریبوت است"
                : $"پروویژن و ثبت موفق — MAC: {mac} — دستگاه در حال ریبوت است";
            _provSuccess = true;
            StateHasChanged();
            await Task.Delay(3000);
            CloseModals();
            await LoadStations();
            StateHasChanged();
        }
        else
        {
            _provResult = err ?? "خطا در پروویژن";
            _provSuccess = false;
            StateHasChanged();
        }
    }

    private void AppendFlashLine(string line)
    {
        _liveFlashLines.Add(line);
        InvokeAsync(StateHasChanged);
    }

    private void OpenRegisterModal(string mac, string ip)
    {
        _regForm = new RegForm { MacAddress = mac, Ip = ip };
        _showRegModal = true;
    }

    private async Task SaveRegister()
    {
        if (string.IsNullOrWhiteSpace(_regForm.Name))
        {
            _message = "نام دستگاه را وارد کنید";
            _msgSuccess = false;
            return;
        }

        _saving = true;
        var (ok, err) = await StationService.RegisterAsync(_regForm.MacAddress, _regForm.Name, _regForm.Description, _regForm.Ip, _regForm.Type);
        _saving = false;

        if (ok)
        {
            _message = "دستگاه ثبت شد — در انتظار اتصال خودکار دستگاه...";
            _msgSuccess = true;
            CloseModals();
            await LoadStations();
            _discovered.RemoveAll(u => u.Mac == _regForm.MacAddress);
        }
        else
        {
            _message = err ?? "خطا در ثبت دستگاه";
            _msgSuccess = false;
        }
    }

    private void OpenEditModal(StationDto station)
    {
        _editTarget = station;
        _editForm = new EditForm { Name = station.Name, Description = station.Description, IsEnabled = station.IsEnabled, Type = station.Type };
        _showEditModal = true;
    }

    private async Task SaveEdit()
    {
        if (_editTarget == null) return;
        _saving = true;
        var ok = await StationService.UpdateAsync(_editTarget.MacAddress, _editForm.Name, _editForm.Description, _editForm.IsEnabled, _editForm.Type);
        _saving = false;

        if (ok)
        {
            _message = "دستگاه با موفقیت ویرایش شد";
            _msgSuccess = true;
            CloseModals();
            await LoadStations();
        }
        else
        {
            _message = "خطا در ویرایش دستگاه";
            _msgSuccess = false;
        }
    }

    private async Task DeleteStation(string mac)
    {
        var ok = await StationService.DeleteAsync(mac);
        if (ok)
        {
            _message = "دستگاه حذف شد";
            _msgSuccess = true;
            await LoadStations();
        }
        else
        {
            _message = "خطا در حذف دستگاه";
            _msgSuccess = false;
        }
    }

    private void CloseModals()
    {
        _showProvModal = false;
        _showRegModal  = false;
        _showEditModal = false;
        _editTarget    = null;
    }

    private class ProvForm
    {
        public string ServerAddress { get; set; } = "";
        public string PortName { get; set; } = "";
        public string Ssid { get; set; } = "";
        public string Password { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool FlashFirst { get; set; } = true;
        public int StationType { get; set; } = 0;
    }

    private class RegForm
    {
        public string MacAddress { get; set; } = "";
        public string Ip { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public int Type { get; set; } = 0;
    }

    private class EditForm
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsEnabled { get; set; } = true;
        public int Type { get; set; } = 0;
    }

    private static string TypeLabel(int t) => t switch
    {
        1 => "در",
        2 => "ریموت",
        _ => "جنرال"
    };

    private static string TypeBadgeClass(int t) => t switch
    {
        1 => "badge-purple",
        2 => "badge-orange",
        _ => "badge-blue"
    };
}

<style>
    .page { direction: rtl; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: #1a1a2e; }

    .alert { padding: 12px 18px; border-radius: 10px; margin-bottom: 16px; font-size: 14px; font-weight: 500; }
    .alert-success { background: #d4edda; color: #1a7a3c; border: 1px solid #a8ddb8; }
    .alert-error { background: #fdecea; color: #c00; border: 1px solid #f8bbbb; }

    .section { margin-bottom: 32px; }
    .section-title { font-size: 16px; font-weight: 600; color: #0f3460; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid #e8f0fe; }

    .data-table { width: 100%; border-collapse: collapse; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.07); font-size: 14px; }
    .data-table th { background: #f0f4ff; padding: 12px 16px; text-align: right; font-weight: 600; color: #333; border-bottom: 2px solid #e0e8ff; }
